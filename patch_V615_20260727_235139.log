'@
  $PLAN = @(
    @{ name='SalesProspect.html'; data=$B_SalesProspect_html; sha='dc6a91549db876224d525fc16840a7aab9f2b943c8b895d19c7ef9f04b2ab236'; size=675432 },
    @{ name='overrides.html'; data=$B_overrides_html; sha='ab9d21a67ca57706f7202aa2fe9918075666bc69cf4263000fe8e895376e468c'; size=186890 }
  )
  foreach ($p in $PLAN) { Copy-Item (Join-Path $ROOT $p.name) ((Join-Path $ROOT $p.name) + '.bak_' + $stamp) -Force }
  Write-Host '[1/4] backup done' -ForegroundColor Cyan
  foreach ($p in $PLAN) {
    $gz = [Convert]::FromBase64String(($p.data -replace '\s',''))
    $ms = New-Object IO.MemoryStream(,$gz)
    $gs = New-Object IO.Compression.GZipStream($ms, [IO.Compression.CompressionMode]::Decompress)
    $out = New-Object IO.MemoryStream
    $gs.CopyTo($out); $gs.Dispose(); $ms.Dispose()
    $bytes = $out.ToArray(); $out.Dispose()
    if ($bytes.Length -ne $p.size) { throw ('size mismatch ' + $p.name) }
    [IO.File]::WriteAllBytes((Join-Path $ROOT $p.name), $bytes)
  }
  Write-Host '[2/4] files written' -ForegroundColor Cyan
  $EXP = @{
    'SalesProspect.html' = 'dc6a91549db876224d525fc16840a7aab9f2b943c8b895d19c7ef9f04b2ab236'
    'body_app_top.html' = '81d6d76a20b253a238349d6b7a9e7f3a6bb44235a27d80b781115eaa5ef9fb7b'
    'script_main.html' = '9378064ad1a68ffd2af51b5acfff6eda2b94e2c758da2a827f76c42a358c8305'
    'overrides.html' = 'ab9d21a67ca57706f7202aa2fe9918075666bc69cf4263000fe8e895376e468c'
  }
  $bad = @()
  foreach ($k in $EXP.Keys) {
    $h = (Get-FileHash (Join-Path $ROOT $k) -Algorithm SHA256).Hash.ToLower()
    if ($h -ne $EXP[$k]) { $bad += $k } else { Write-Host ('      ok ' + $k) }
  }
  if ($bad.Count -gt 0) { throw ('wrong: ' + ($bad -join ', ')) }
  Write-Host '[3/4] all 4 files verified' -ForegroundColor Green
  clasp push --force
  if ($LASTEXITCODE -ne 0) { throw 'clasp push failed' }
  clasp create-deployment -i AKfycbzO7LW1DPUOzosAxpZsJPvX8PoW4eJ8rDHuZI-GXwHpT9yXDERnrEdPVvdOoffQLVF-kw -d 'V615.0 Price Book'
  if ($LASTEXITCODE -ne 0) { throw 'create-deployment failed' }
  git add -A
  git commit -m 'V615.0: Price Book - brand/model filter dropdowns, filtered CSV export'
  git push
  Write-Host '[4/4] deployed + pushed -> V615.0' -ForegroundColor Green
  Write-Host 'NEXT: Ctrl+F5' -ForegroundColor Yellow
}
catch { Write-Host ''; Write-Host ('[ERROR] ' + $_.Exception.Message) -ForegroundColor Red }
